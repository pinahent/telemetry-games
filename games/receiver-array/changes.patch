+
+/* ---------------------------------------
+   DIFFICULTY SELECTION
+---------------------------------------- */
+
+.difficulty-control {
+  display: flex;
+  flex: 0 0 auto;
+  gap: 9px;
+  align-items: center;
+  justify-content: flex-end;
+}
+
+.difficulty-buttons {
+  display: inline-flex;
+  border: 1px solid rgba(24, 49, 59, 0.55);
+  background: rgba(255, 253, 247, 0.72);
+  box-shadow: 2px 2px 0 rgba(24, 49, 59, 0.12);
+}
+
+.difficulty-button {
+  min-height: 36px;
+  min-width: 76px;
+  padding: 7px 12px;
+  border: 0;
+  border-right: 1px solid rgba(24, 49, 59, 0.24);
+  color: var(--ink);
+  background: transparent;
+  font-family: var(--font-interface);
+  font-size: 0.8rem;
+  font-weight: 800;
+  letter-spacing: 0.035em;
+  cursor: pointer;
+}
+
+.difficulty-button:last-child {
+  border-right: 0;
+}
+
+.difficulty-button:hover:not(:disabled) {
+  background: rgba(23, 111, 135, 0.11);
+}
+
+.difficulty-button.is-active,
+.difficulty-button[aria-checked="true"] {
+  color: var(--white);
+  background: var(--blue-dark);
+}
+
+.difficulty-button:focus-visible {
+  position: relative;
+  z-index: 2;
+  outline: 3px solid rgba(197, 154, 55, 0.48);
+  outline-offset: 2px;
+}
+
+.difficulty-button:disabled {
+  cursor: not-allowed;
+  opacity: 0.52;
+}
+
+/* Seven compact status cells plus the wider state cell. */
+.hud {
+  grid-template-columns: repeat(6, minmax(96px, 1fr)) minmax(150px, 1.35fr);
+}
+
+.hud-difficulty {
+  border-top: 3px solid var(--blue);
+}
+
+@media (max-width: 1120px) {
+  .hud {
+    grid-template-columns: repeat(4, minmax(110px, 1fr));
+  }
+}
+
+@media (max-width: 760px) {
+  .sheet-heading {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .difficulty-control {
+    width: 100%;
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .difficulty-buttons {
+    width: 100%;
+  }
+
+  .difficulty-button {
+    flex: 1 1 0;
+    min-width: 0;
+  }
+}
+
+@media (max-width: 700px) {
+  .hud {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .button,
+  .difficulty-button,
+  .language-button,
+  .utility-button {
+    transition: none;
+  }
+}
